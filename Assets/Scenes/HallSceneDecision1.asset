    AvatarImage: {fileID: 21300000, guid: 7dbec25a864f74d628678e2db35ae817, type: 3}
    DialogText: '

      You hear a disturbance nextdoor, but you are unsure what
      it is.  What will you do?'
    UseCurrentVals: 0
    FontSize: 0.05
    TextPaddingPct: 0.05
    TypeDelay: 0.05
    HScalePct: 1
    VScalePct: 1.2
    NormHPos: 0
    NormVPos: -0.3
    BackgroundColor: {r: 0.11372549, g: 0.11372549, b: 0.11372549, a: 0.5882353}
