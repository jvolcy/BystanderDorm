    ChildNodeOnTimeout: 0
    ExternalFunctionToken: 
    Collapsed: 0
  ChildNodes:
  - ChoiceText: Do not get involved.  The neighbor did mention you should ignore
      any loud noises coming from her room.
    ChildNode: {fileID: 0}
    ChildConnectionPoint: {x: 715.3333, y: 457.33334}
  - ChoiceText: 'Go knock on her door: do a wellness check on your neighbor, ignoring
      her warning to not disturb.'
    ChildNode: {fileID: 0}
    ChildConnectionPoint: {x: 715.3333, y: 477.33334}
  - ChoiceText: Immediately report the incident to the RA,  risking explelling your
      neighbor from the dorm.
    ChildNode: {fileID: 0}
    ChildConnectionPoint: {x: 715.3333, y: 497.33334}
  - ChoiceText: Wait until the morning and file an anonymous  incident report with
      the Title IX Office.
    ChildNode: {fileID: 0}
    ChildConnectionPoint: {x: 715.3333, y: 517.3333}
  - ChoiceText: Pull the fire alarm to create a disturbance.
    ChildNode: {fileID: 0}
    ChildConnectionPoint: {x: 715.3333, y: 537.3333}
